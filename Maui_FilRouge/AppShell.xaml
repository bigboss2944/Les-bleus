<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Maui_FilRouge.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Maui_FilRouge.Views"
    FlyoutBehavior="Disabled"
    Title="Fil Rouge">

    <ShellContent
        Title="Connexion"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="login" />

    <ShellContent
        Title="Commandes"
        ContentTemplate="{DataTemplate views:OrdersListPage}"
        Route="orders" />

</Shell>
